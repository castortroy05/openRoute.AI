# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# PostgreSQL Settings (for production)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=openroute_db
# DATABASE_USER=openroute_user
# DATABASE_PASSWORD=your-password-here
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Paywall Configuration
# Set to True to enable subscription/paywall features
PAYWALL_ENABLED=False

# Stripe Configuration (for paywall)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Redis Configuration (for caching and performance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Ad Configuration (for lower tiers)
# Get your AdSense code from https://www.google.com/adsense/
AD_PROVIDER=google_adsense
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-your-adsense-id-here
GOOGLE_ADSENSE_SLOT_ID=your-ad-slot-id-here

# OpenAI API (for future implementation)
OPENAI_API_KEY=your-openai-api-key-here

# Mapping and Routing APIs
# OpenRouteService API - FREE tier: 2000 requests/day
# Get your free API key from https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-here
# Overpass API (OSM data) - No API key needed, free and open source
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Email Settings (for future use)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Media and Static Files
MEDIA_ROOT=flags
STATIC_ROOT=staticfiles

# Security Settings (Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
